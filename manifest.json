{
  "manifest_version": 3,
  "name": "Google Drive - Private Video Downloader",
  "version": "1.3.1",
  "description": "Download progressive video streams and supported files from your authenticated Google Drive session.",
  "icons": {
    "16": "assets/icon.png",
    "32": "assets/icon.png",
    "48": "assets/icon.png",
    "64": "assets/icon.png",
    "128": "assets/icon.png",
    "256": "assets/icon.png",
    "512": "assets/icon.png"
  },
  "permissions": [
    "debugger",
    "activeTab",
    "scripting",
    "tabs",
    "downloads",
    "storage"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "assets/icon.png"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "minimum_chrome_version": "102"
}
